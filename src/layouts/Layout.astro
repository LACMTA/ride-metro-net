---
import AnalyticsBody from "../components/AnalyticsBody.astro";
import AnalyticsHead from "../components/AnalyticsHead.astro";
import Footer from "../components/Footer";
import Header from "../components/Header";
import SystemWideAlert from "../components/SystemWideAlert";
import "../styles/fonts.css";
import "../styles/global.css";

const { title, screen = false, fullHeight = false } = Astro.props;
const includeAnalytics = import.meta.env.PROD && !screen;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {includeAnalytics && <AnalyticsHead />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class={screen
      ? "bg-black text-white font-sans"
      : fullHeight
        ? "font-sans flex flex-col h-dvh overflow-hidden"
        : "font-sans"}
  >
    {includeAnalytics && <AnalyticsBody />}
    {!screen && <Header />}
    {!screen && <SystemWideAlert client:load />}
    {
      fullHeight ? (
        <div class="flex-1 overflow-hidden">
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
    {!screen && !fullHeight && <Footer />}
  </body>
</html>
