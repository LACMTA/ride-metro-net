---
import DataInjector from "./DataInjector.astro";
import type { SystemMapData } from "../lib/getAllRouteShapes";

interface Props {
  data: SystemMapData;
}

const { data } = Astro.props;
const esriKey = import.meta.env.ESRI_KEY;
---

<DataInjector data={data} id="data-system-map" />
<div class="h-full w-full" data-system-map data-esri-key={esriKey}>
  <div
    class="h-full w-full"
    aria-label="Map of Metro rail and busway lines"
    role="img"
    data-map-container
  >
  </div>
</div>

<script>
  import { createMap } from "../lib/createMap";
  import { getData } from "../lib/getData";
  import type { SystemMapData } from "../lib/getAllRouteShapes";
  import type { FeatureCollection, LineString, Point } from "geojson";
  import { getLineSlug } from "../lib/routeShortNameOverrides";

  /**
   * Pixel spacing between adjacent side-by-side lines. Offset slots from the
   * build-time processor are ±1, ±2, … in steps of 2, so the visual gap
   * between two co-running 5px lines is `2 * OFFSET_STEP_PX`.
   */
  const OFFSET_STEP_PX = 3;

  /** Unique source/layer IDs for the system map. */
  const LINES_SOURCE = "system-lines";
  const LINES_LAYER = "system-lines";
  const STATIONS_SOURCE = "system-stations";
  const STATIONS_LAYER = "system-stations";

  function initSystemMap(container: HTMLElement): void {
    const esriKey = container.dataset.esriKey!;
    const mapContainer = container.querySelector(
      "[data-map-container]",
    ) as HTMLElement;

    const data = getData("data-system-map") as SystemMapData;

    async function bootstrap() {
      const { map, maplibregl } = await createMap(mapContainer, esriKey);

      if (data.lines.length === 0) return;

      // -----------------------------------------------------------------
      // Build a GeoJSON FeatureCollection of LineStrings from all route
      // segments. Each feature carries `color` and `offset` (in pixels)
      // so the line layer can apply a data-driven `line-offset` and
      // `line-color` — no third-party plugin needed.
      // -----------------------------------------------------------------
      const lineFeatures: FeatureCollection<LineString> = {
        type: "FeatureCollection",
        features: [],
      };

      for (const line of data.lines) {
        const { color, routeId, routeShortName } = line;
        const slug = getLineSlug(routeId);
        const popupHtml = `<a href="/lines/${slug}" style="font-weight:bold;color:${color}">${routeShortName} Line</a>`;

        for (const segment of line.segments) {
          lineFeatures.features.push({
            type: "Feature",
            geometry: {
              type: "LineString",
              coordinates: segment.coordinates,
            },
            properties: {
              color,
              offset: segment.offset * OFFSET_STEP_PX,
              popupHtml,
            },
          });
        }
      }

      // -----------------------------------------------------------------
      // Build a GeoJSON FeatureCollection of Points for stations.
      // -----------------------------------------------------------------
      const stationFeatures: FeatureCollection<Point> = {
        type: "FeatureCollection",
        features: data.stations.map((station) => ({
          type: "Feature",
          geometry: {
            type: "Point",
            coordinates: [station.lon, station.lat],
          },
          properties: {
            lineCount: station.lineCount,
            radius: station.lineCount > 1 ? 4 + station.lineCount * 1.75 : 4,
            popupHtml: `<a href="/stops/${station.stationId}" style="font-weight:600">${station.stopName}</a>`,
          },
        })),
      };

      // Wait for the map style to load before adding sources/layers.
      map.on("load", () => {
        // --- Lines ---
        map.addSource(LINES_SOURCE, {
          type: "geojson",
          data: lineFeatures,
        });

        map.addLayer({
          id: LINES_LAYER,
          type: "line",
          source: LINES_SOURCE,
          paint: {
            "line-color": ["get", "color"],
            "line-width": 5,
            "line-opacity": 0.9,
            "line-offset": ["get", "offset"],
          },
        });

        // --- Stations ---
        map.addSource(STATIONS_SOURCE, {
          type: "geojson",
          data: stationFeatures,
        });

        map.addLayer({
          id: STATIONS_LAYER,
          type: "circle",
          source: STATIONS_SOURCE,
          paint: {
            "circle-radius": ["get", "radius"],
            "circle-color": "#ffffff",
            "circle-stroke-color": "#1a1a1a",
            "circle-stroke-width": [
              "case",
              [">", ["get", "lineCount"], 1],
              2,
              1.5,
            ],
            "circle-stroke-opacity": 1,
            "circle-opacity": 1,
          },
        });

        // --- Popups ---
        const popup = new maplibregl.Popup({
          closeButton: false,
          closeOnClick: true,
        });

        map.on("click", LINES_LAYER, (e) => {
          const feature = e.features?.[0];
          if (!feature) return;
          const html = feature.properties?.popupHtml;
          if (typeof html === "string") {
            popup.setHTML(html);
            popup.setLngLat(e.lngLat);
            popup.addTo(map);
          }
        });

        map.on("click", STATIONS_LAYER, (e) => {
          const feature = e.features?.[0];
          if (!feature) return;
          const html = feature.properties?.popupHtml;
          if (typeof html === "string") {
            popup.setHTML(html);
            popup.setLngLat(e.lngLat);
            popup.addTo(map);
          }
        });

        // Cursor feedback.
        map.on("mouseenter", LINES_LAYER, () => {
          map.getCanvas().style.cursor = "pointer";
        });
        map.on("mouseleave", LINES_LAYER, () => {
          map.getCanvas().style.cursor = "";
        });
        map.on("mouseenter", STATIONS_LAYER, () => {
          map.getCanvas().style.cursor = "pointer";
        });
        map.on("mouseleave", STATIONS_LAYER, () => {
          map.getCanvas().style.cursor = "";
        });

        // Fit bounds to all line coordinates.
        const bounds = new maplibregl.LngLatBounds();
        for (const feature of lineFeatures.features) {
          for (const coord of feature.geometry.coordinates) {
            bounds.extend(coord as [number, number]);
          }
        }
        if (!bounds.isEmpty()) {
          map.fitBounds(bounds, { padding: 20 });
        }
      });
    }

    bootstrap();
  }

  // Initialise all system map containers on the page.
  document.querySelectorAll("[data-system-map]").forEach((el) => {
    initSystemMap(el as HTMLElement);
  });
</script>
