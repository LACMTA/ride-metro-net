---
import DataInjector from "./DataInjector.astro";
import type { SystemMapData } from "../lib/getAllRouteShapes";
import type { ServiceAreaBbox } from "../lib/getBusStopsForBbox";
import { getAgencySettings } from "../lib/agencies";

interface Props {
  data: SystemMapData;
  serviceAreaBbox: ServiceAreaBbox;
}

const { data, serviceAreaBbox } = Astro.props;
const esriKey = import.meta.env.ESRI_KEY;

// Bus stop marker color — uses the LA Metro Bus agency default line color
// (which matches --color-bus-local / --color-burnt-orange from the Tailwind
// theme). Passed to the client via a data attribute since agencies.ts has
// server-side side effects and can't be imported in the browser.
const busStopColor = getAgencySettings("LACMTA")?.lineColor ?? "#e16710";
---

<DataInjector data={data} id="data-system-map" />
<div
  class="relative h-full w-full"
  data-system-map
  data-esri-key={esriKey}
  data-bus-stop-color={busStopColor}
  data-service-area-bbox={`${serviceAreaBbox.minLon},${serviceAreaBbox.minLat},${serviceAreaBbox.maxLon},${serviceAreaBbox.maxLat}`}
>
  <div
    class="h-full w-full"
    aria-label="Map of Metro rail and busway lines"
    role="img"
    data-map-container
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-3 left-3 z-10 rounded bg-white/90 px-3 py-1.5 text-sm text-gray-600 shadow-sm"
    role="status"
    aria-live="polite"
    data-bus-stop-info
    hidden
  >
    <span data-bus-stop-info-text></span>
  </div>

  <!-- "Find my location" button — overlays the map bottom-right corner. The
       ESRI attribution control has been moved to the bottom-left (see
       createMap.ts) so this corner is clear. Centers the map on the user's
       location and drops a blue "you are here" marker. -->
  <button
    type="button"
    class="text-blue absolute right-3 bottom-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-md transition-colors hover:bg-gray-50 disabled:cursor-wait disabled:opacity-60"
    aria-label="Find my location"
    title="Find my location"
    data-locate-button
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0 0 13 3.06V1h-2v2.06A8.994 8.994 0 0 0 3.06 11H1v2h2.06A8.994 8.994 0 0 0 11 20.94V23h2v-2.06A8.994 8.994 0 0 0 20.94 13H23v-2h-2.06zM12 19c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"
      ></path>
    </svg>
  </button>

  <!-- Transient status message for the locate button (errors / unsupported). -->
  <div
    class="pointer-events-none absolute bottom-3 left-1/2 z-10 -translate-x-1/2 rounded bg-white/90 px-3 py-1.5 text-sm text-gray-600 shadow-sm"
    role="status"
    aria-live="polite"
    data-locate-status
    hidden
  >
    <span data-locate-status-text></span>
  </div>
</div>

<script>
  import { createMap } from "../lib/createMap";
  import { getData } from "../lib/getData";
  import type { SystemMapData } from "../lib/getAllRouteShapes";
  import type { Feature, FeatureCollection, LineString, Point } from "geojson";
  import { getLineSlug, isBuswayRoute } from "../lib/routeShortNameOverrides";
  import {
    makeCasingLayer,
    makeLineLayer,
    makeStopLayer,
    makeBusStopLayer,
    makePopupOptions,
    attachPopupHandlers,
    fitBoundsToCoords,
    buildStopPopupHtml,
    buildLinePopupHtml,
    STOP_STROKE_DARK,
    BUS_STOP_MIN_ZOOM,
    BUSWAY_STOP_RADIUS,
    BUSWAY_STOP_RADIUS_MAX,
    BUSWAY_STOP_STROKE_WIDTH,
    BUSWAY_STOP_STROKE_WIDTH_MAX,
    RAIL_STOP_RADIUS,
    RAIL_STOP_RADIUS_MAX,
    RAIL_STOP_STROKE_WIDTH,
    RAIL_STOP_STROKE_WIDTH_MAX,
    STOP_MIN_ZOOM,
    STOP_MAX_ZOOM,
  } from "../lib/mapStyles";
  import {
    BUS_STOP_GRID_SIZE,
    BUS_STOP_PREFETCH_TILES,
    snapToGrid,
    gridXForLon,
    gridYForLat,
  } from "../lib/busStopTiles";
  import {
    systemMapFlyTarget,
    flyToLocation,
    systemMapViewport,
    systemMapLocateRequest,
  } from "../lib/systemMapStore";
  import {
    fetchTile as fetchBusStopTile,
    hasTile as hasBusStopTile,
  } from "../lib/busStopTileCache";

  /**
   * Pixel spacing between adjacent side-by-side lines. Offset slots from the
   * build-time processor are ±1, ±2, … in steps of 2, so the visual gap
   * between two co-running 6px lines is `2 * OFFSET_STEP_PX`.
   */
  const OFFSET_STEP_PX = 3;

  /** Unique source/layer IDs for the system map. */
  const LINES_SOURCE = "system-lines";
  const CASING_LAYER = "system-lines-casing";
  const LINES_LAYER = "system-lines";
  const STATIONS_SOURCE = "system-stations";
  const STATIONS_LAYER = "system-stations";
  const BUSWAY_STATIONS_LAYER = "system-busway-stations";
  const BUS_STOPS_SOURCE = "bus-stops";
  const BUS_STOPS_LAYER = "bus-stops";

  function initSystemMap(container: HTMLElement): void {
    const esriKey = container.dataset.esriKey!;
    const busStopColor = container.dataset.busStopColor ?? "#e16710";

    // Service area bounding box — tiles outside this area are never fetched.
    const bboxStr = container.dataset.serviceAreaBbox;
    const serviceArea = bboxStr ? bboxStr.split(",").map(Number) : null;

    const mapContainer = container.querySelector(
      "[data-map-container]",
    ) as HTMLElement;

    const data = getData("data-system-map") as SystemMapData;
    const infoEl = container.querySelector(
      "[data-bus-stop-info]",
    ) as HTMLElement;
    const infoText = container.querySelector(
      "[data-bus-stop-info-text]",
    ) as HTMLElement;
    const locateStatusEl = container.querySelector(
      "[data-locate-status]",
    ) as HTMLElement | null;
    const locateStatusText = container.querySelector(
      "[data-locate-status-text]",
    ) as HTMLElement | null;

    async function bootstrap() {
      const { map, maplibregl } = await createMap(mapContainer, esriKey);

      // --- Fly-to listener ---
      // The sidebar sets `systemMapFlyTarget` (e.g. when "nearby" is tapped).
      // We listen immediately so a target set before the map's `load` event
      // is not lost. If the map isn't loaded yet, we defer the `easeTo` until
      // `load` fires and then consume the current store value.
      let mapLoaded = false;

      /** Publish the current center/zoom so the sidebar can compute "nearby". */
      function publishViewport(): void {
        const c = map.getCenter();
        systemMapViewport.set({ lon: c.lng, lat: c.lat, zoom: map.getZoom() });
      }

      systemMapFlyTarget.listen((target) => {
        if (!target) return;
        if (!mapLoaded) return;
        map.easeTo({
          center: [target.lon, target.lat],
          zoom: target.zoom,
          duration: 800,
        });
        systemMapFlyTarget.set(null);
      });

      // Consume any target that was set before the map finished loading.
      map.on("load", () => {
        mapLoaded = true;
        const pending = systemMapFlyTarget.get();
        if (pending) {
          map.easeTo({
            center: [pending.lon, pending.lat],
            zoom: pending.zoom,
            duration: 800,
          });
          systemMapFlyTarget.set(null);
        }

        // Publish the initial viewport so the sidebar has a center to work
        // with even before the user moves the map.
        publishViewport();

        // Consume a locate request that arrived before the map loaded.
        if (systemMapLocateRequest.get()) {
          systemMapLocateRequest.set(false);
          locateUser();
        }
      });

      // Re-publish the viewport whenever the map stops moving — this covers
      // drag-end, zoom, and programmatic `easeTo` pans (e.g. from find-me).
      map.on("moveend", () => {
        publishViewport();
      });

      // --- Find-me (locate) ---
      // Shared by the find-my-location button overlay and the sidebar's
      // "Nearby" tab (via the `systemMapLocateRequest` store). Requests the
      // user's geolocation, pans/zooms the map to that point (via the shared
      // fly-to store), and drops a blue "you are here" marker that stays
      // anchored to the coordinate as the user pans/zooms.
      const locateBtn = container.querySelector(
        "[data-locate-button]",
      ) as HTMLButtonElement | null;

      /** Show a transient locate status message for a few seconds. */
      function showLocateMessage(msg: string): void {
        if (!locateStatusEl || !locateStatusText) return;
        locateStatusText.textContent = msg;
        locateStatusEl.hidden = false;
        window.setTimeout(() => {
          if (locateStatusText.textContent === msg) {
            locateStatusEl.hidden = true;
          }
        }, 4000);
      }

      let locationMarker: maplibregl.Marker | null = null;

      /**
       * Request geolocation, pan the map to the result, and drop/update the
       * "you are here" marker. Called by the find-me button and by the
       * sidebar's "Nearby" tab (via `systemMapLocateRequest`).
       */
      function locateUser(): void {
        if (!("geolocation" in navigator)) {
          showLocateMessage("Geolocation is not supported by your browser.");
          return;
        }

        if (locateBtn) {
          locateBtn.disabled = true;
          locateBtn.setAttribute("aria-busy", "true");
        }

        navigator.geolocation.getCurrentPosition(
          (position) => {
            const { latitude, longitude } = position.coords;

            // Pan/zoom the map to the user's location via the shared
            // fly-to store (reuses the listener registered above).
            flyToLocation(longitude, latitude);

            // Drop or update the blue "you are here" marker.
            if (!locationMarker) {
              const el = document.createElement("div");
              el.className = "metro-location-marker";
              locationMarker = new maplibregl.Marker({
                element: el,
                anchor: "center",
              })
                .setLngLat([longitude, latitude])
                .addTo(map);
            } else {
              locationMarker.setLngLat([longitude, latitude]);
            }

            if (locateBtn) {
              locateBtn.disabled = false;
              locateBtn.removeAttribute("aria-busy");
            }
          },
          (err) => {
            if (locateBtn) {
              locateBtn.disabled = false;
              locateBtn.removeAttribute("aria-busy");
            }
            showLocateMessage(
              err.code === err.PERMISSION_DENIED
                ? "Location permission denied."
                : "Unable to determine your location.",
            );
          },
          { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 },
        );
      }

      if (locateBtn) {
        locateBtn.addEventListener("click", locateUser);
      }

      // Listen for locate requests from the sidebar (e.g. the "Nearby" tab).
      // Mirrors the fly-target pattern: defer until the map has loaded.
      systemMapLocateRequest.listen((requested) => {
        if (!requested) return;
        if (!mapLoaded) return;
        systemMapLocateRequest.set(false);
        locateUser();
      });

      if (data.lines.length === 0) return;

      // -----------------------------------------------------------------
      // Build a GeoJSON FeatureCollection of LineStrings from all route
      // segments. Each feature carries `color` and `offset` (in pixels)
      // so the line layer can apply a data-driven `line-offset` and
      // `line-color` — no third-party plugin needed.
      // -----------------------------------------------------------------
      const lineFeatures: FeatureCollection<LineString> = {
        type: "FeatureCollection",
        features: [],
      };

      for (const line of data.lines) {
        const { color, routeId, routeShortName } = line;
        const slug = getLineSlug(routeId);
        const popupHtml = buildLinePopupHtml({ slug, routeShortName, color });

        for (const segment of line.segments) {
          lineFeatures.features.push({
            type: "Feature",
            geometry: {
              type: "LineString",
              coordinates: segment.coordinates,
            },
            properties: {
              color,
              offset: segment.offset * OFFSET_STEP_PX,
              popupHtml,
            },
          });
        }
      }

      // -----------------------------------------------------------------
      // Build a GeoJSON FeatureCollection of Points for stations.
      // -----------------------------------------------------------------
      const stationFeatures: FeatureCollection<Point> = {
        type: "FeatureCollection",
        features: data.stations.map((station) => {
          // A station is "busway" if any of its lines is a busway route.
          // Busway stops come in pairs (one per direction), so they get
          // smaller markers with the line color as the stroke.
          const isBusway = station.lines.some((line) =>
            isBuswayRoute(line.routeId),
          );
          // Stroke color for the station marker:
          // - Busway: the first busway line's color (line-colored stroke)
          // - Single-line rail: that line's color
          // - Multi-line rail (interchange): dark stroke (STOP_STROKE_DARK)
          const strokeColor = isBusway
            ? (station.lines.find((line) => isBuswayRoute(line.routeId))
                ?.color ?? "#e16710")
            : station.lines.length === 1
              ? (station.lines[0]?.color ?? STOP_STROKE_DARK)
              : STOP_STROKE_DARK;
          return {
            type: "Feature",
            geometry: {
              type: "Point",
              coordinates: [station.lon, station.lat],
            },
            properties: {
              isBusway,
              color: strokeColor,
              popupHtml: buildStopPopupHtml({
                stopId: station.stationId,
                stopName: station.stopName,
                badges: [...station.lines, ...station.busRoutes],
              }),
            },
          };
        }),
      };

      // Wait for the map style to load before adding sources/layers.
      map.on("load", () => {
        // --- Lines source (shared by casing + colored layers) ---
        map.addSource(LINES_SOURCE, {
          type: "geojson",
          data: lineFeatures,
        });

        // White casing layer — drawn underneath for visual separation of
        // overlapping lines.
        map.addLayer(makeCasingLayer(CASING_LAYER, LINES_SOURCE));

        // Colored line layer — drawn on top of the casing.
        map.addLayer(
          makeLineLayer(LINES_LAYER, LINES_SOURCE, {
            color: ["get", "color"],
            offset: ["get", "offset"],
          }),
        );

        // --- Stations ---
        map.addSource(STATIONS_SOURCE, {
          type: "geojson",
          data: stationFeatures,
        });

        // Busway stations — white fill, line-color stroke, smaller markers.
        // Busway stops come in pairs (one per direction), so smaller markers
        // prevent overlap and the colored stroke ties them to their line.
        // Added before the rail layer so rail stations render on top.
        map.addLayer(
          makeStopLayer(BUSWAY_STATIONS_LAYER, STATIONS_SOURCE, {
            strokeColor: ["get", "color"],
            radius: [
              "interpolate",
              ["linear"],
              ["zoom"],
              STOP_MIN_ZOOM,
              BUSWAY_STOP_RADIUS,
              STOP_MAX_ZOOM,
              BUSWAY_STOP_RADIUS_MAX,
            ],
            strokeWidth: [
              "interpolate",
              ["linear"],
              ["zoom"],
              STOP_MIN_ZOOM,
              BUSWAY_STOP_STROKE_WIDTH,
              STOP_MAX_ZOOM,
              BUSWAY_STOP_STROKE_WIDTH_MAX,
            ],
            filter: ["==", ["get", "isBusway"], true],
          }),
        );

        // Rail stations — white fill, data-driven stroke color (line color
        // for single-line stations, dark for interchanges), smaller markers
        // than the default stop sizes but still larger than busway/bus stops.
        // Added after the busway layer so rail stations render on top.
        map.addLayer(
          makeStopLayer(STATIONS_LAYER, STATIONS_SOURCE, {
            strokeColor: ["get", "color"],
            radius: [
              "interpolate",
              ["linear"],
              ["zoom"],
              STOP_MIN_ZOOM,
              RAIL_STOP_RADIUS,
              STOP_MAX_ZOOM,
              RAIL_STOP_RADIUS_MAX,
            ],
            strokeWidth: [
              "interpolate",
              ["linear"],
              ["zoom"],
              STOP_MIN_ZOOM,
              RAIL_STOP_STROKE_WIDTH,
              STOP_MAX_ZOOM,
              RAIL_STOP_STROKE_WIDTH_MAX,
            ],
            filter: ["!=", ["get", "isBusway"], true],
          }),
        );

        // --- Popups ---
        const popup = new maplibregl.Popup(makePopupOptions());

        attachPopupHandlers(map, LINES_LAYER, popup);
        attachPopupHandlers(map, STATIONS_LAYER, popup);
        attachPopupHandlers(map, BUSWAY_STATIONS_LAYER, popup);

        // Fit bounds to all line coordinates.
        const allCoords: [number, number][] = lineFeatures.features
          .flatMap((f) => f.geometry.coordinates)
          .map(([lng, lat]) => [lng, lat]);
        fitBoundsToCoords(map, maplibregl, allCoords);

        // ---------------------------------------------------------------
        // Bus stops — loaded on-demand from the API when zoomed in.
        // The viewport is broken into small grid tiles, each fetched
        // independently so that dense areas don't block sparse ones.
        // Tile URLs are stable for HTTP caching, and a Map<stopId, Feature>
        // provides client-side deduplication so panning back to a
        // previously-visited area doesn't re-add duplicates.
        // ---------------------------------------------------------------

        // --- Bus stop info overlay ---
        // Toggles a small status badge over the map to indicate when bus
        // stops are hidden (zoom too low) or loading. Uses an HTML overlay
        // rather than a MapLibre layer for accessibility (aria-live) and
        // code simplicity.
        /** Count of in-flight tile fetches, for the loading indicator. */
        let busStopsInFlight = 0;

        function updateBusStopInfo(): void {
          if (map.getZoom() < BUS_STOP_MIN_ZOOM) {
            infoText.textContent = "Zoom in to see bus stops";
            infoEl.hidden = false;
          } else if (busStopsInFlight > 0) {
            infoText.textContent = "Bus stops loading…";
            infoEl.hidden = false;
          } else {
            infoEl.hidden = true;
          }
        }

        // Set of station IDs already rendered as rail/busway station markers.
        // Bus stops that are also stations are skipped to avoid duplicate
        // markers — the station marker (with busway line badges) is the
        // primary marker for such stops.
        const stationIds = new Set(data.stations.map((s) => s.stationId));

        map.addSource(BUS_STOPS_SOURCE, {
          type: "geojson",
          data: { type: "FeatureCollection", features: [] },
        });

        map.addLayer(
          makeBusStopLayer(BUS_STOPS_LAYER, BUS_STOPS_SOURCE, {
            minzoom: BUS_STOP_MIN_ZOOM,
            color: busStopColor,
          }),
        );

        attachPopupHandlers(map, BUS_STOPS_LAYER, popup);

        // Accumulated bus stop features, keyed by stop_id for deduplication.
        const busStopMap = new Map<
          string,
          Feature<Point, { popupHtml: string }>
        >();

        /** Grid tiles already fetched, keyed `"gridX,gridY"` to avoid
         * re-requesting the same tile on pan. Persists across zoom/pan. */
        const fetchedTiles = new Set<string>();

        /** Update the GeoJSON source with all accumulated bus stops. */
        function syncBusStopSource(): void {
          const source = map.getSource(BUS_STOPS_SOURCE);
          if (source && source.type === "geojson") {
            (source as maplibregl.GeoJSONSource).setData({
              type: "FeatureCollection",
              features: [...busStopMap.values()],
            });
          }
        }

        /**
         * Fetch bus stops for a single grid tile and merge results into
         * `busStopMap`. The tile key is recorded in `fetchedTiles` so it
         * won't be re-requested. Fetching goes through the shared
         * `busStopTileCache` so tiles the sidebar already loaded (e.g. for a
         * "nearby" search) are instant cache hits.
         */
        async function fetchTile(tileKey: string): Promise<void> {
          if (fetchedTiles.has(tileKey)) return;
          fetchedTiles.add(tileKey);

          busStopsInFlight++;
          updateBusStopInfo();

          let addedAny = false;

          try {
            const stops = await fetchBusStopTile(tileKey);

            for (const stop of stops) {
              if (busStopMap.has(stop.stopId)) continue;
              if (stationIds.has(stop.stopId)) continue;
              busStopMap.set(stop.stopId, {
                type: "Feature",
                geometry: {
                  type: "Point",
                  coordinates: [stop.lon, stop.lat],
                },
                properties: {
                  popupHtml: buildStopPopupHtml({
                    stopId: stop.stopId,
                    stopName: stop.stopName,
                    badges: stop.routes,
                  }),
                },
              });
              addedAny = true;
            }
          } finally {
            // If the fetch failed at the network level (the cache does not
            // persist network errors), allow a retry on the next pan —
            // mirrors the previous retry-on-error behavior.
            if (!hasBusStopTile(tileKey)) fetchedTiles.delete(tileKey);
            // Incremental rendering — push new stops to the map as soon
            // as this tile resolves, rather than waiting for all tiles.
            if (addedAny) syncBusStopSource();
            busStopsInFlight--;
            updateBusStopInfo();
          }
        }

        /**
         * Kick off tile fetches for every grid tile intersecting the current
         * viewport (plus a prefetch margin). Each tile is fetched independently
         * and renders incrementally as it resolves. Previously-fetched tiles
         * are skipped via `fetchedTiles`, so calling this on every `move` event
         * does not create redundant requests — just like basemap tile loading.
         */
        function fetchBusStops(): void {
          if (map.getZoom() < BUS_STOP_MIN_ZOOM) {
            updateBusStopInfo();
            return;
          }

          const bounds = map.getBounds();
          const margin = BUS_STOP_GRID_SIZE * BUS_STOP_PREFETCH_TILES;
          const west = snapToGrid(bounds.getWest()) - margin;
          const south = snapToGrid(bounds.getSouth()) - margin;
          const east =
            snapToGrid(bounds.getEast()) + BUS_STOP_GRID_SIZE + margin;
          const north =
            snapToGrid(bounds.getNorth()) + BUS_STOP_GRID_SIZE + margin;

          for (let lon = west; lon < east; lon += BUS_STOP_GRID_SIZE) {
            for (let lat = south; lat < north; lat += BUS_STOP_GRID_SIZE) {
              // Skip tiles outside the service area — no fetch, no 404.
              // Mark them as fetched so they're not retried on pan.
              if (
                serviceArea &&
                (lon < serviceArea[0] ||
                  lat < serviceArea[1] ||
                  lon > serviceArea[2] ||
                  lat > serviceArea[3])
              ) {
                const tileKey = `${gridXForLon(lon)},${gridYForLat(lat)}`;
                fetchedTiles.add(tileKey);
                continue;
              }
              const tileKey = `${gridXForLon(lon)},${gridYForLat(lat)}`;
              fetchTile(tileKey);
            }
          }
        }

        // Fetch bus stops on map movement — no debounce needed since
        // `fetchedTiles` prevents redundant requests. New tiles start
        // loading as soon as they enter the viewport, like basemap tiles.
        map.on("move", () => {
          fetchBusStops();
        });

        // Initial fetch in case the map starts zoomed in.
        fetchBusStops();
      });
    }

    bootstrap();
  }

  // Initialise all system map containers on the page.
  document.querySelectorAll("[data-system-map]").forEach((el) => {
    initSystemMap(el as HTMLElement);
  });
</script>
