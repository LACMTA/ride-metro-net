---
import "leaflet/dist/leaflet.css";

interface Props {
  /** Numeric route ID prefix (e.g. "801", "720") for the API endpoint. */
  routeId: string;
  /** GTFS `route_color` hex without the leading `#`, e.g. `"E47525"`. */
  routeColor: string;
}

const { routeId, routeColor } = Astro.props;
const esriKey = import.meta.env.ESRI_KEY;
---

<div
  class="bg-background-white mb-8 rounded-lg"
  data-line-map
  data-route-id={routeId}
  data-route-color={routeColor}
  data-esri-key={esriKey}
>
  <div class="mb-2 flex flex-wrap items-center gap-3 px-3 pt-3 pb-1">
    <div data-split-line-control hidden>
      <label class="mr-2 font-medium" for="split-line-select">Line:</label>
      <select
        id="split-line-select"
        class="border-divider-line rounded border px-2 py-1"
      ></select>
    </div>
    <div data-service-type-control hidden>
      <label class="mr-2 font-medium" for="service-type-select">Service:</label>
      <select
        id="service-type-select"
        class="border-divider-line rounded border px-2 py-1"
      >
        <option value="core">Core</option>
        <option value="owl">Owl</option>
      </select>
    </div>
    <div>
      <label class="mr-2 font-medium" for="shape-select">To:</label>
      <select
        id="shape-select"
        class="border-divider-line rounded border px-2 py-1"
      ></select>
    </div>
  </div>

  <div
    class="h-96 w-full overflow-hidden"
    aria-label="Map of Metro line route"
    role="img"
    data-map-container
  >
  </div>
</div>

<script>
  import type { RouteShapesGeoJSON, RouteShapeFeature } from "../lib/getRouteShapes";
  import { lightenColor } from "../lib/lightenColor";
  import {
    lineMapGeoJson,
    lineMapSelection,
    setLineMapGeoJson,
    setServiceType,
    setSplitLineNumber,
    setDirectionId,
    getFilteredShapes,
  } from "../lib/lineMapStore";

  // Default center: LA Metro service area
  const DEFAULT_CENTER: [number, number] = [
    34.00095151499077, -118.25133692966446,
  ];
  const DEFAULT_ZOOM = 11;

  // ESRI basemap configuration — Metro branded vector basemap.
  // See https://github.com/LACMTA/map-template.
  const ESRI_BASERMAP_ENUM = "65aff2873118478482ec3dec199e9058";

  type LeafletModule = typeof import("leaflet");

  interface MapState {
    L: LeafletModule;
    map: import("leaflet").Map;
    shapeLayer: import("leaflet").LayerGroup | null;
    stopsLayer: import("leaflet").LayerGroup | null;
  }

  function shapeOptionLabel(feature: RouteShapeFeature): string {
    const stops = feature.properties.stops;
    const terminal = stops.at(-1);
    return terminal ? terminal.stopName : "Unknown direction";
  }

  function initMap(container: HTMLElement): void {
    const routeId = container.dataset.routeId!;
    const routeColor = container.dataset.routeColor!;
    const esriKey = container.dataset.esriKey!;

    const controlRoot = container.closest("[data-line-map]")!;
    const splitLineControl = controlRoot.querySelector(
      "[data-split-line-control]",
    ) as HTMLElement;
    const serviceTypeControl = controlRoot.querySelector(
      "[data-service-type-control]",
    ) as HTMLElement;
    const splitLineSelect = controlRoot.querySelector(
      "#split-line-select",
    ) as HTMLSelectElement;
    const serviceTypeSelect = controlRoot.querySelector(
      "#service-type-select",
    ) as HTMLSelectElement;
    const shapeSelect = controlRoot.querySelector(
      "#shape-select",
    ) as HTMLSelectElement;
    const mapContainer = controlRoot.querySelector(
      "[data-map-container]",
    ) as HTMLElement;

    let state: MapState | null = null;

    async function bootstrap() {
      const [{ default: L }, { vectorBasemapLayer }] = await Promise.all([
        import("leaflet"),
        import("esri-leaflet-vector"),
      ]);

      const map = L.map(mapContainer, { minZoom: 2 }).setView(
        DEFAULT_CENTER,
        DEFAULT_ZOOM,
      );

      // Metro branded ESRI vector basemap.
      vectorBasemapLayer(ESRI_BASERMAP_ENUM, {
        apiKey: esriKey,
      }).addTo(map);

      state = {
        L,
        map,
        shapeLayer: null,
        stopsLayer: null,
      };

      // Fetch the route shape GeoJSON from the cached API endpoint.
      try {
        const res = await fetch(`/api/route-shape/${routeId}.json`);
        if (!res.ok) {
          throw new Error(`Shape fetch failed: ${res.status}`);
        }
        const data = (await res.json()) as RouteShapesGeoJSON;

        if (!state) return;

        // Push geojson + default selection into the shared nanostore.
        setLineMapGeoJson(data);

        populateControls();
        renderSelection();
      } catch (err) {
        // Non-fatal: leave the map on its default LA-wide view.
        console.error("Failed to load route shape:", err);
      }
    }

    function getGhostFeatures(geojson: RouteShapesGeoJSON): RouteShapeFeature[] {
      const selection = lineMapSelection.get();
      const splitNum = selection.splitLineNumber;
      const serviceType = selection.serviceType;
      return geojson.features.filter((f) => {
        const fSplit = f.properties.splitLineNumber;
        const sameSplit = splitNum === null ? fSplit === undefined : fSplit === splitNum;
        const diffSplit = !sameSplit;
        const diffService = f.properties.serviceType !== serviceType;
        // Exactly one dimension differs.
        return diffService !== diffSplit && (diffService || diffSplit);
      });
    }

    function populateControls() {
      const geojson = lineMapGeoJson.get();
      if (!geojson) return;
      const selection = lineMapSelection.get();

      // Split-line selector
      if (geojson.isSplitline) {
        const seen = new Set<string>();
        for (const f of geojson.features) {
          if (f.properties.splitLineNumber !== undefined) {
            seen.add(f.properties.splitLineNumber);
          }
        }
        const numbers = [...seen].sort();
        if (numbers.length > 0) {
          splitLineControl.hidden = false;
          splitLineSelect.innerHTML = numbers
            .map((num) => `<option value="${num}">${num}</option>`)
            .join("");
          splitLineSelect.value = selection.splitLineNumber ?? numbers[0];
        }
      }

      // Service type selector — show only if owl service exists for the
      // current split-line selection.
      const hasOwl = geojson.features.some(
        (f) =>
          f.properties.serviceType === "owl" &&
          (selection.splitLineNumber === null ||
            f.properties.splitLineNumber === selection.splitLineNumber),
      );
      if (hasOwl) {
        serviceTypeControl.hidden = false;
        serviceTypeSelect.value = selection.serviceType;
      } else {
        serviceTypeControl.hidden = true;
      }

      // Direction selector — options are keyed by GTFS direction_id (0 or 1)
      // rather than array index, so the store can filter by direction.
      // We need all features matching the service type + split-line (ignoring
      // direction) to populate the dropdown with one option per direction.
      const allForDirections = geojson.features.filter(
        (f) =>
          f.properties.serviceType === selection.serviceType &&
          (selection.splitLineNumber === null ||
            f.properties.splitLineNumber === selection.splitLineNumber),
      );
      // Deduplicate by direction_id, keeping the first feature for each.
      const seenDirs = new Set<number>();
      const dirOptions: RouteShapeFeature[] = [];
      for (const f of allForDirections) {
        const dirId = f.properties.directionIds[0] ?? 0;
        if (!seenDirs.has(dirId)) {
          seenDirs.add(dirId);
          dirOptions.push(f);
        }
      }
      dirOptions.sort(
        (a, b) => (a.properties.directionIds[0] ?? 0) - (b.properties.directionIds[0] ?? 0),
      );
      shapeSelect.innerHTML = dirOptions
        .map(
          (f) =>
            `<option value="${f.properties.directionIds[0] ?? 0}">${shapeOptionLabel(f)}</option>`,
        )
        .join("");
      shapeSelect.value = String(selection.directionId);
    }

    function renderSelection() {
      if (!state?.L || !state.map) return;
      const geojson = lineMapGeoJson.get();
      if (!geojson || geojson.features.length === 0) return;
      const selection = lineMapSelection.get();

      const filtered = getFilteredShapes(geojson, selection);
      if (filtered.length === 0) return;

      const feature = filtered[0];

      // Remove previous shape and stop layers.
      if (state.shapeLayer) {
        state.shapeLayer.remove();
        state.shapeLayer = null;
      }
      if (state.stopsLayer) {
        state.stopsLayer.remove();
        state.stopsLayer = null;
      }

      const lineColor = routeColor ? `#${routeColor}` : "#000";
      const ghostColor = lightenColor(lineColor, 0.5);
      const L = state.L;
      const map = state.map;

      const shapeGroup = L.layerGroup().addTo(map);
      state.shapeLayer = shapeGroup;

      // Ghost layer: features that differ from the current selection in
      // exactly one dimension — the unselected split-line side (same service
      // type) or the unselected service type (same split-line, e.g. owl when
      // core is selected). Rendered as a lightened tint at full opacity so
      // overlapping ghost lines don't darken each other the way translucent
      // (alpha-blended) lines do.
      const ghostFeatures = getGhostFeatures(geojson);
      if (ghostFeatures.length > 0) {
        L.geoJSON(
          {
            type: "FeatureCollection",
            features: ghostFeatures,
          } as import("geojson").FeatureCollection,
          {
            style: { color: ghostColor, weight: 6, opacity: 1 },
          },
        ).addTo(shapeGroup);
      }

      // Selected feature layer — rendered on top of the ghost.
      L.geoJSON(feature, {
        style: { color: lineColor, weight: 6, opacity: 0.9 },
      }).addTo(shapeGroup);

      // Render a circle marker for each stop served by the selected shape.
      const stopsGroup = L.layerGroup().addTo(map);
      state.stopsLayer = stopsGroup;

      for (const stop of feature.properties.stops) {
        L.circleMarker([stop.lat, stop.lon], {
          radius: 5,
          color: lineColor,
          weight: 3,
          fillColor: "#fff",
          fillOpacity: 1,
        })
          .bindPopup(`<strong>${stop.stopName}</strong>`)
          .addTo(stopsGroup);
      }

      // Fit the map to the selected feature AND the ghost (when present).
      const allLatLngs: [number, number][] = [
        ...feature.geometry.coordinates.map(
          ([lon, lat]) => [lat, lon] as [number, number],
        ),
        ...feature.properties.stops.map(
          (s) => [s.lat, s.lon] as [number, number],
        ),
      ];

      for (const gf of getGhostFeatures(geojson)) {
        for (const [lon, lat] of gf.geometry.coordinates) {
          allLatLngs.push([lat, lon]);
        }
      }

      map.fitBounds(L.latLngBounds(allLatLngs), { padding: [20, 20] });
    }

    splitLineSelect.addEventListener("change", (e) => {
      setSplitLineNumber((e.target as HTMLSelectElement).value || null);
    });
    serviceTypeSelect.addEventListener("change", (e) => {
      setServiceType((e.target as HTMLSelectElement).value as "core" | "owl");
    });
    shapeSelect.addEventListener("change", (e) => {
      setDirectionId(Number((e.target as HTMLSelectElement).value));
    });

    // Re-render the map whenever the selection store changes (this covers
    // both user-driven control changes and external updates from the
    // StopList component or any other consumer).
    lineMapSelection.listen(() => {
      populateControls();
      renderSelection();
    });

    bootstrap();
  }

  // Initialise all line map containers on the page.
  document.querySelectorAll("[data-line-map]").forEach((el) => {
    initMap(el as HTMLElement);
  });
</script>