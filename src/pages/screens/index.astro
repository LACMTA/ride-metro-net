---
export const prerender = false;

import getStopWithRoutes from "../../lib/getStopWithRoutes";
import type { StopRoute } from "../../lib/getStopWithRoutes";
import { getAgencySettings } from "../../lib/agencies";
import DataInjector from "../../components/DataInjector.astro";
import RoutePrediction from "../../components/ScreenPredictions";

/**
 * /screens/index.astro
 *
 * Multi-stop arrival board (data layer only - no styling yet).
 *
 * Accepts a comma-separated `stopId` query parameter:
 *   /screens/?stopId=80122,80123
 *
 * Multiple stop IDs may refer to the same physical stop (different agencies
 * use different stop_id values), so all routes from all requested stops are
 * merged into a single flat list.
 */

// ---------------------------------------------------------------------------
// Parse stopId query parameter (comma-separated)
// ---------------------------------------------------------------------------
const stopIdParam = Astro.url.searchParams.get("stopId") ?? "";
const stopIds = stopIdParam
  .split(",")
  .map((id) => id.trim())
  .filter(Boolean);

// ---------------------------------------------------------------------------
// Fetch data for each stop and merge all routes into a single array.
// Collect all stop IDs (including child/platform IDs) for predictions polling.
// ---------------------------------------------------------------------------
const allRoutes: StopRoute[] = [];
const notFoundStopIds: string[] = [];
const allPredictionStopIds: string[] = [];

for (const stopId of stopIds) {
  try {
    const stop = await getStopWithRoutes(stopId);
    allRoutes.push(...stop.routes);
    allPredictionStopIds.push(stop.stopId, ...stop.childStopIds);
  } catch {
    notFoundStopIds.push(stopId);
  }
}

const uniquePredictionStopIds = [...new Set(allPredictionStopIds)];
---

<DataInjector data={uniquePredictionStopIds} id="screen-stop-ids" />
<script>
  import { getData } from "../../lib/getData";
  import watchPredictions from "../../lib/watchPredictions";

  const stopIds = getData("screen-stop-ids") as string[];
  watchPredictions(stopIds);
</script>

{
  stopIds.length === 0 ? (
    <p>
      No stopId query parameter provided. Usage: /screens/?stopId=80122,80123
    </p>
  ) : (
    <div>
      <h1>Arrival Board</h1>

      <h2>Routes</h2>
      {allRoutes.length === 0 ? (
        <p>No routes found for the requested stops.</p>
      ) : (
        <ul>
          {allRoutes.map((route) => {
            const agencySettings = getAgencySettings(route.agencyId);
            return (
              <li style={agencySettings?.color ? `border-left: 4px solid ${agencySettings.color}; padding-left: 8px;` : undefined}>
                {agencySettings?.logoFile && (
                  <img
                    src={`/agency-logos/${agencySettings.logoFile}`}
                    alt=""
                    style="height: 20px; vertical-align: middle; margin-right: 6px;"
                  />
                )}
                <strong style={agencySettings?.color ? `color: ${agencySettings.color};` : undefined}>
                  {route.routeShortName}
                </strong> (route ID: {route.routeId}
                , agency: {route.agencyId}
                {agencySettings?.color && <>, color: {agencySettings.color}</>}
                {agencySettings?.logoFile && <>, logo: /agency-logos/{agencySettings.logoFile}</>}
                , type: {route.routeType}, direction: {route.directionId})
                {route.headsigns.length > 0 && (
                  <> - Headsigns: {route.headsigns.join(", ")}</>
                )}
                {route.routeType !== 3 && <> - Platform: {route.childStopId}</>}
                <RoutePrediction routeId={route.routeId} directionId={route.directionId} client:load />
              </li>
            );
          })}
        </ul>
      )}

      {notFoundStopIds.length > 0 && (
        <p>
          <em>Stops not found: {notFoundStopIds.join(", ")}</em>
        </p>
      )}
    </div>
  )
}
