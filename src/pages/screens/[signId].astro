---
export const prerender = true;

import getStopWithRoutes from "../../lib/getStopWithRoutes";
import type { StopRoute } from "../../lib/getStopWithRoutes";
import type {
  ScreenHeaderComponent,
  ScreenRouteStopComponent,
} from "../../data/types";
import { getScreenSignEntries, getScreenSign } from "../../lib/getScreenSigns";
import DataInjector from "../../components/DataInjector.astro";
import RoutePrediction from "../../components/ScreenPredictions";
import Layout from "../../layouts/Layout.astro";
import RouteBadge from "../../components/RouteBadge";

/**
 * /screens/[signId].astro
 *
 * Config-driven arrival board. Each sign is defined in `src/data/screenSigns.json`
 * and pre-rendered at build time. Real-time predictions are polled client-side.
 *
 * The sign displays exactly what its required `displayOrder` array lists, in
 * order — `route-stop` components render the card(s) for one exact (route,
 * stop) pair so duplicates between nearby stops serving the same route can
 * be excluded intentionally, and header components render between the rows.
 * Routes serving the configured stops but not listed in `displayOrder` are
 * not displayed.
 */

export async function getStaticPaths() {
  return getScreenSignEntries().map(({ signId }) => ({
    params: { signId },
  }));
}

const { signId } = Astro.params;
const signConfig = getScreenSign(signId);

if (!signConfig) {
  throw new Error(`No screen sign config found for signId: ${signId}`);
}

if (!Array.isArray(signConfig.displayOrder)) {
  throw new Error(
    `Screen sign config for "${signId}" is missing its required "displayOrder" array.`,
  );
}

// ---------------------------------------------------------------------------
// Fetch data for each stop and group the merged route cards by
// "routeId:stopId" pair. Collect all stop IDs (including child/platform IDs)
// for predictions polling.
// ---------------------------------------------------------------------------
const routesByPair = new Map<string, StopRoute[]>();
const notFoundStopIds: string[] = [];
const allPredictionStopIds: string[] = [];

for (const stopId of signConfig.stopIds) {
  try {
    const stop = await getStopWithRoutes(stopId);
    for (const route of stop.routes) {
      const pairKey = `${route.routeId}:${stopId}`;
      const pairCards = routesByPair.get(pairKey);
      if (pairCards) pairCards.push(route);
      else routesByPair.set(pairKey, [route]);
    }
    allPredictionStopIds.push(stop.stopId, ...stop.childStopIds);
  } catch {
    notFoundStopIds.push(stopId);
  }
}

console.warn(
  `Stops not found for screen ${signId}: ${notFoundStopIds.join(", ")}`,
);

const uniquePredictionStopIds = [...new Set(allPredictionStopIds)];

// ---------------------------------------------------------------------------
// Build the render list from `displayOrder`: each `route-stop` entry renders
// only the card(s) for that one exact (route, stop) pair — a route can still
// appear in multiple directions at its stop — and header entries render
// between the rows. Routes not listed are never displayed; unknown entries
// (including leftover route-ID strings from the old shorthand) are skipped
// with a warning so a bad hand edit can't break the build.
// ---------------------------------------------------------------------------
type ScreenRenderItem =
  | { type: "header"; text: string }
  | { type: "route"; route: StopRoute };

function isHeaderComponent(entry: unknown): entry is ScreenHeaderComponent {
  return (
    typeof entry === "object" &&
    entry !== null &&
    (entry as ScreenHeaderComponent).component === "header" &&
    typeof (entry as ScreenHeaderComponent).text === "string"
  );
}

function isRouteStopComponent(
  entry: unknown,
): entry is ScreenRouteStopComponent {
  return (
    typeof entry === "object" &&
    entry !== null &&
    (entry as ScreenRouteStopComponent).component === "route-stop" &&
    typeof (entry as ScreenRouteStopComponent).routeId === "string" &&
    typeof (entry as ScreenRouteStopComponent).stopId === "string"
  );
}

const renderItems: ScreenRenderItem[] = [];

for (const [index, entry] of signConfig.displayOrder.entries()) {
  if (isRouteStopComponent(entry)) {
    const pairCards =
      routesByPair.get(`${entry.routeId}:${entry.stopId}`) ?? [];
    const cards =
      entry.directionId === undefined
        ? pairCards
        : pairCards.filter((route) => route.directionId === entry.directionId);
    if (cards.length === 0) {
      console.warn(
        `Skipping route-stop displayOrder entry ${JSON.stringify(entry)} at index ${index} for screen ${signId}: no matching card.`,
      );
    }
    for (const route of cards) {
      renderItems.push({ type: "route", route });
    }
  } else if (isHeaderComponent(entry)) {
    renderItems.push({ type: "header", text: entry.text });
  } else {
    console.warn(
      `Skipping unknown displayOrder entry ${JSON.stringify(entry)} at index ${index} for screen ${signId}.`,
    );
  }
}
---

<DataInjector data={uniquePredictionStopIds} id="screen-stop-ids" />
<script>
  import { getData } from "../../lib/getData";
  import watchPredictions from "../../lib/watchPredictions";

  const stopIds = getData("screen-stop-ids") as string[];
  watchPredictions(stopIds);
</script>

<Layout screen={true} title={`Metro Screen Display — ${signId}`}>
  {
    renderItems.length === 0 ? (
      <p>No routes configured for this sign.</p>
    ) : (
      <div class="">
        {renderItems.map((item) => {
          if (item.type === "header") {
            return (
              <h2 class="border-b-4 border-gray-900 px-4 pt-8 pb-3 text-center text-5xl font-bold tracking-wide">
                {item.text}
              </h2>
            );
          }

          const route = item.route;
          return (
            <div class="grid grid-cols-12 gap-4 border-b-4 border-gray-900">
              <div class="col-span-9 flex items-center justify-start py-4 pl-4">
                <RouteBadge
                  routeId={route.routeId}
                  routeType={route.routeType}
                  name={route.routeShortName}
                  color={route.routeColor}
                  textColor={route.routeTextColor}
                  size="xl"
                />
                <div class="ml-5 overflow-hidden">
                  <div class="mt-7 text-left text-4xl text-nowrap">
                    {route.headsigns[0].replace(" Station", "")}
                  </div>
                  <div class="h-7 text-xl text-nowrap">
                    {route.headsigns.length > 1 && (
                      <>
                        {" "}
                        {route.headsigns
                          .slice(1)
                          .map((h) => h.replace(" Station", ""))
                          .join(", ")}
                      </>
                    )}
                  </div>
                </div>
              </div>
              <div class="col-span-3 flex items-center justify-end py-4 pr-4 text-right text-4xl">
                <RoutePrediction
                  routeId={route.routeId}
                  directionId={route.directionId}
                  stopId={route.childStopId}
                  client:load
                />
              </div>
            </div>
          );
        })}
      </div>
    )
  }
</Layout>
