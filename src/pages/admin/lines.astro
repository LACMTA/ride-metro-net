---
import AdminLayout from "../../layouts/AdminLayout.astro";
import LineEditor from "../../components/admin/LineEditor";

export const prerender = false;

// Read the ESRI basemap key server-side and pass it into the island as a
// prop (same pattern as SystemMap.astro / LineMap.astro — Astro env-schema
// variables are not inlined into client-side import.meta.env).
const esriKey = import.meta.env.ESRI_KEY;
---

<AdminLayout title="Lines - Admin">
  <main>
    <LineEditor client:load esriKey={esriKey} />
  </main>
</AdminLayout>
