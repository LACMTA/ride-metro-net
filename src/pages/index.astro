---
import Layout from "../layouts/Layout.astro";
import SystemMap from "../components/SystemMap.astro";
import SystemMapSidebar from "../components/SystemMapSidebar";
import getAllRouteShapes from "../lib/getAllRouteShapes";
import getAllBusRoutes from "../lib/getAllBusRoutes";
import getAllRailBuswayRoutes from "../lib/getAllRailBuswayRoutes";
import { getBusStopServiceAreaBbox } from "../lib/getBusStopsForBbox";

export const prerender = true;

const systemMapData = await getAllRouteShapes();
const serviceAreaBbox = getBusStopServiceAreaBbox();

const busRoutes = await getAllBusRoutes();
const railBuswayRoutes = await getAllRailBuswayRoutes();
const allLines = [...railBuswayRoutes, ...busRoutes];
---

<Layout title="Metro System Map" fullHeight>
  <div class="flex h-full overflow-hidden">
    <!-- Mobile sidebar toggle button -->
    <button
      id="sidebar-toggle"
      class="bg-background-white border-divider-line absolute top-3 left-3 z-30 flex h-10 w-10 items-center justify-center rounded-lg border shadow-sm md:hidden"
      aria-label="Toggle sidebar"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width={2}
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Mobile backdrop -->
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 z-20 hidden bg-black/30 md:hidden"
    >
    </div>

    <!-- Sidebar -->
    <aside
      id="sidebar-aside"
      class="bg-background-white border-divider-line fixed inset-y-0 left-0 z-20 w-80 max-w-[85vw] -translate-x-full border-r transition-transform duration-200 md:static md:z-auto md:w-96 md:max-w-none md:translate-x-0"
    >
      <SystemMapSidebar
        client:load
        lines={allLines}
        stations={systemMapData.stations}
      />
    </aside>

    <!-- Map -->
    <div class="flex-1 overflow-hidden">
      <SystemMap data={systemMapData} serviceAreaBbox={serviceAreaBbox} />
    </div>
  </div>

  <script>
    const toggle = document.getElementById("sidebar-toggle");
    const backdrop = document.getElementById("sidebar-backdrop");
    const aside = document.getElementById("sidebar-aside");

    function openSidebar() {
      aside?.classList.remove("-translate-x-full");
      backdrop?.classList.remove("hidden");
    }

    function closeSidebar() {
      aside?.classList.add("-translate-x-full");
      backdrop?.classList.add("hidden");
    }

    toggle?.addEventListener("click", () => {
      if (aside?.classList.contains("-translate-x-full")) {
        openSidebar();
      } else {
        closeSidebar();
      }
    });

    backdrop?.addEventListener("click", closeSidebar);
  </script>
</Layout>
