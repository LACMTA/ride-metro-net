---
import Layout from "../layouts/Layout.astro";
import SystemMap from "../components/SystemMap.astro";
import SystemMapSidebar from "../components/SystemMapSidebar";
import getAllRouteShapes from "../lib/getAllRouteShapes";
import getAllBusRoutes from "../lib/getAllBusRoutes";
import getAllRailBuswayRoutes from "../lib/getAllRailBuswayRoutes";
import { getBusStopServiceAreaBbox } from "../lib/getBusStopsForBbox";

export const prerender = true;

const systemMapData = await getAllRouteShapes();
const serviceAreaBbox = getBusStopServiceAreaBbox();

const busRoutes = await getAllBusRoutes();
const railBuswayRoutes = await getAllRailBuswayRoutes();
const allLines = [...railBuswayRoutes, ...busRoutes];
---

<Layout title="Metro System Map" fullHeight>
  <div class="relative flex h-full overflow-hidden">
    <!-- Mobile backdrop. `absolute inset-0` (not `fixed`) so it's contained
         to this map-area wrapper rather than the full viewport — it won't dim
         or overlay the sitewide header above. -->
    <div
      id="sidebar-backdrop"
      class="absolute inset-0 z-20 hidden bg-black/30 md:hidden"
    >
    </div>

    <!-- Sidebar. `absolute inset-y-0 left-0` (not `fixed`) anchors it to this
         map-area wrapper (`relative`), so the drawer opens within the map
         area — below the header — instead of covering the full viewport. -->
    <aside
      id="sidebar-aside"
      class="bg-background-white border-divider-line absolute inset-y-0 left-0 z-20 w-80 max-w-[85vw] -translate-x-full border-r transition-transform duration-200 md:static md:z-auto md:w-96 md:max-w-none md:translate-x-0"
    >
      <SystemMapSidebar
        client:load
        lines={allLines}
        stations={systemMapData.stations}
      />
    </aside>

    <!-- Map -->
    <div class="flex-1 overflow-hidden">
      <SystemMap data={systemMapData} serviceAreaBbox={serviceAreaBbox} />
    </div>
  </div>

  <script>
    import { sidebarOpen } from "../lib/systemMapStore";

    const toggle = document.getElementById("sidebar-toggle");
    const backdrop = document.getElementById("sidebar-backdrop");
    const aside = document.getElementById("sidebar-aside");

    /** Reflect the shared sidebarOpen store onto the DOM (translate + backdrop). */
    function applySidebarState(open: boolean) {
      if (open) {
        aside?.classList.remove("-translate-x-full");
        backdrop?.classList.remove("hidden");
      } else {
        aside?.classList.add("-translate-x-full");
        backdrop?.classList.add("hidden");
      }
    }

    // Keep the DOM in sync with the store. This is the single source of truth:
    // both the hamburger toggle button and the sidebar's left-arrow close
    // button write to `sidebarOpen`, and this listener applies the result.
    sidebarOpen.listen(applySidebarState);
    applySidebarState(sidebarOpen.get());

    toggle?.addEventListener("click", () => {
      sidebarOpen.set(!sidebarOpen.get());
    });

    backdrop?.addEventListener("click", () => {
      sidebarOpen.set(false);
    });
  </script>
</Layout>
