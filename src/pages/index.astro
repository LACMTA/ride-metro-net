---
import Layout from "../layouts/Layout.astro";
import SystemMap from "../components/SystemMap.astro";
import SystemMapSidebar from "../components/SystemMapSidebar";
import getAllRouteShapes from "../lib/getAllRouteShapes";
import getAllBusRoutes from "../lib/getAllBusRoutes";
import getAllRailBuswayRoutes from "../lib/getAllRailBuswayRoutes";
import { getBusStopServiceAreaBbox } from "../lib/getBusStopsForBbox";

export const prerender = true;

const systemMapData = await getAllRouteShapes();
const serviceAreaBbox = getBusStopServiceAreaBbox();

const busRoutes = await getAllBusRoutes();
const railBuswayRoutes = await getAllRailBuswayRoutes();
const allLines = [...railBuswayRoutes, ...busRoutes];
---

<Layout title="Metro System Map" fullHeight>
  <!-- Column on mobile: map on top, sidebar docked at the bottom of the
       screen (always visible). Row on desktop: sidebar left, map right
       (unchanged). -->
  <div class="relative flex h-full flex-col overflow-hidden md:flex-row">
    <!-- Map -->
    <div class="order-1 min-h-0 flex-1 overflow-hidden md:order-2">
      <SystemMap data={systemMapData} serviceAreaBbox={serviceAreaBbox} />
    </div>

    <!-- Sidebar. Always-visible bottom panel on mobile (`order-2` places it
         below the map in the column layout; `md:order-1` restores it to the
         left on desktop). In-flow flex child at both breakpoints — no more
         absolute positioning, z-index, translate, or backdrop. -->
    <aside
      class="bg-background-white border-divider-line order-2 h-[40dvh] w-full shrink-0 border-t md:order-1 md:h-full md:w-96 md:border-t-0 md:border-r"
    >
      <SystemMapSidebar client:load lines={allLines} />
    </aside>
  </div>

  <script>
    import watchAlerts from "../lib/watchAlerts";

    // Populate the alerts store so the sitewide SystemWideAlert banner
    // (rendered by Layout) has data on this page. With no stop/route filter
    // this fetches all active alerts, including system-wide ones.
    watchAlerts();
  </script>
</Layout>
