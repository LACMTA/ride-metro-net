{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@esri/maplibre-arcgis": [
        "./node_modules/@esri/maplibre-arcgis/dist/esm/types/src/MaplibreArcGIS.d.ts"
