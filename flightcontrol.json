{
  "$schema": "https://app.flightcontrol.dev/schema.json",
  "environments": [
    {
      "id": "ride-metro-net",
      "name": "ride-metro-net",
      "region": "us-west-1",
      "source": {
        "pr": false,
        "branch": "flightcontrol",
        "trigger": "push"
      },
      "services": [
        {
          "id": "astro-app-ntvIGO",
          "name": "ride.metro.net",
          "target": {
            "type": "ecs-ec2",
            "clusterInstanceSize": "t3.medium",
            "clusterMinInstances": 1,
            "clusterMaxInstances": 10,
            "storage": 30
          },
          "buildType": "nixpacks",
          "cpu": 1,
          "gpu": 0,
          "memory": 2,
          "ci": {
            "type": "ec2",
            "instanceStorage": 30,
            "storageThroughput": 125,
            "storageIops": 3000,
            "storageType": "gp3"
          },
          "containerInsights": false,
          "autoscalingEnabled": true,
          "minInstances": 1,
          "maxInstances": 1,
          "versionHistoryCount": 10,
          "basePath": ".",
          "startCommand": ["HOST=0.0.0.0 PORT=8080 tsx server.ts"],
          "privileged": false,
          "envVariables": {},
          "autoscaling": {
            "cpuThreshold": 70,
            "memoryThreshold": 70,
            "scaleInCooldownTimerSecs": 300,
            "scaleOutCooldownTimerSecs": 300,
            "requestsPerTarget": 500
          },
          "includeEnvVariablesInBuild": true,
          "logging": {
            "firelensImage": "public.ecr.aws/aws-observability/aws-for-fluent-bit:stable",
            "ecsLogsMetadataEnabled": false,
            "cloudwatchLogsEnabled": true,
            "envVariables": {}
          },
          "cloudfrontAutoCacheInvalidation": true,
          "ecsStopTimeoutSecs": 90,
          "healthCheckTimeoutSecs": 4,
          "healthCheckIntervalSecs": 5,
          "healthCheckPath": "/alerts",
          "port": 8080,
          "stickySessionsEnabled": false,
          "stickySessionsDurationSecs": 86400,
          "originShieldEnabled": true,
          "deploy": {
            "type": "rolling"
          },
          "enableCloudfrontSwr": false,
          "type": "web"
        }
      ]
    }
  ]
}
